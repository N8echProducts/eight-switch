{
    "manufacturer": "N8ech",
    "keyboard_name": "Eight-Switch",
    "maintainer": "npmaile",
    "url": "https://github.com/npmaile/eight-switch",
    "processor": "RP2040",
    "bootloader": "rp2040",
    "usb": {
        "vid": "0xFEED",
        "pid": "0x0008",
        "device_version": "1.0.0"
    },
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "matrix_pins": {
        "direct": [
            ["GP0", "GP1", "GP2", "GP3", "GP4", "GP5", "GP6", "GP7", "GP8"]
        ]
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"label": "K1", "matrix": [0, 0], "x": 0, "y": 0},
                {"label": "K2", "matrix": [0, 1], "x": 1, "y": 0},
                {"label": "K3", "matrix": [0, 2], "x": 2, "y": 0},
                {"label": "K4", "matrix": [0, 3], "x": 3, "y": 0},
                {"label": "K5", "matrix": [0, 4], "x": 4, "y": 0},
                {"label": "K6", "matrix": [0, 5], "x": 5, "y": 0},
                {"label": "K7", "matrix": [0, 6], "x": 6, "y": 0},
                {"label": "K8", "matrix": [0, 7], "x": 7, "y": 0},
                {"label": "Send", "matrix": [0, 8], "x": 3.5, "y": 1.25}
            ]
        }
    }
}
